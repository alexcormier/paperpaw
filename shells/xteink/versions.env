# The toolchains and tools a release of the firmware is built with,
# installed by CI and the release workflow (.github/actions/xteink-tools).
# Native code plugins run only on firmware built by the same compiler
# (ADR 0024), so a release names them.
#
# The X4 (ESP32-C3) builds with the Rust of rust-toolchain.toml. The X4
# Pro and the X4 Classic (ESP32-S3, Xtensa) build with espup's `esp`
# toolchain of this version, and the Xtensa GCC 14.2 (newer ones reject
# esp-hal's linker scripts):
#   espup install --targets esp32s3 --toolchain-version 1.97.0.0 \
#     --crosstool-toolchain-version 14.2.0_20241119
ESP_RUST_VERSION=1.97.0.0
ESP_GCC_VERSION=14.2.0_20241119
ESPUP_VERSION=0.18.0
# Makes the images; it brings the bootloader.
ESPFLASH_VERSION=4.6.0
