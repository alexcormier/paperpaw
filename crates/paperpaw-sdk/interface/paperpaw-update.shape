# The shape of this crate's types and the values of its constants, as
# tools/interface.py writes them: fields, variants and trait items in
# the source's order, private fields and the private types they reach
# too, every feature on (ADR 0026).
const paperpaw_update::APP_HEAD_LEN: usize = 208usize
const paperpaw_update::CHIP_ESP32_C3: u16 = 5u16
const paperpaw_update::CHIP_ESP32_S3: u16 = 9u16
const paperpaw_update::FORMAT: u32 = 1u32
const paperpaw_update::MAGIC: [u8; 8] = *b"PaperPaw"
const paperpaw_update::TRAILER_LEN: usize = 128usize
const paperpaw_update::plugins::PLUGINS_AT: usize = 288usize
const paperpaw_update::plugins::PLUGINS_FORMAT: u16 = 1u16
const paperpaw_update::plugins::PLUGINS_HEAD_LEN: usize = 12usize
const paperpaw_update::plugins::PLUGINS_MAGIC: [u8; 8] = *b"PPlugins"
const paperpaw_update::plugins::PLUGINS_MAX_LEN: usize = 16_384usize
enum paperpaw_update::Problem { NotAnUpdate, NewerFormat, NotAnImage, Length, Signature }
struct paperpaw_update::AppInfo { chip: u16, version: alloc::string::String, project: alloc::string::String }
struct paperpaw_update::Check { state: ed25519_compact::ed25519::VerifyingState, signed: [u8; 48], image_len: u32, absorbed: u64 }
struct paperpaw_update::Trailer { image_len: u32, key: [u8; 32], signature: [u8; 64] }
struct paperpaw_update::plugins::PluginCrate<'a> { name: &'a str, version: &'a str }
struct paperpaw_update::plugins::Plugins { text: alloc::borrow::Cow<'static, str> }
