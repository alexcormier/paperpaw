# The shape of this crate's public types, as tools/interface.py writes
# it: fields, variants and trait items in the source's order, private
# fields too (ADR 0026).
enum paperpaw_text::font::Font { Bitmap(0: paperpaw_text::bitmap::BitmapFont), Stored(0: paperpaw_text::stored::StoredPack) }
enum paperpaw_text::font::FontError { Invalid, NoCharmap, UnsupportedVersion, OutlinesNotSupported }
struct paperpaw_text::TextStyle<'a> { font: &'a paperpaw_text::font::Font, font_index: u16, size: f32, color: paperpaw_platform::pixel::Color, bolder: u16, based: bool }
struct paperpaw_text::bitmap::BitmapFont { data: alloc::borrow::Cow<'static, [u8]>, strikes: u16 }
struct paperpaw_text::bitmap::PackBuilder { strikes: alloc::vec::Vec<paperpaw_text::bitmap::StrikeData> }
struct paperpaw_text::cache::GlyphCache { entries: alloc::vec::Vec<paperpaw_text::cache::Entry>, bytes: usize, capacity: usize, clock: u32 }
struct paperpaw_text::font::LineMetrics { ascent: f32, descent: f32, line_height: f32 }
struct paperpaw_text::glyph::Glyph { left: i16, top: i16, width: u16, height: u16, advance: f32, data: alloc::vec::Vec<u8> }
struct paperpaw_text::glyph::GlyphRef<'a> { left: i16, top: i16, width: u16, height: u16, advance: f32, data: &'a [u8] }
struct paperpaw_text::layout::Line { range: core::ops::range::Range<usize>, width: f32, spaces: usize, last: bool, hyphen: bool }
struct paperpaw_text::sfnt::FontInfo { family: alloc::string::String, bold: bool, italic: bool, weight: u16 }
struct paperpaw_text::stored::StoredPack { source: alloc::rcs::rc::Rc<dyn paperpaw_text::stored::PackSource>, strikes: alloc::vec::Vec<paperpaw_text::stored::Strike>, chars: alloc::vec::Vec<char>, advances: core::cell::RefCell<alloc::vec::Vec<core::option::Option<alloc::vec::Vec<u16>>>> }
trait paperpaw_text::stored::PackSource { function read_at }
