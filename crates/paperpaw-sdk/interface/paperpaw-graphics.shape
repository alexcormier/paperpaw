const paperpaw_graphics::round::UNIT: i32 = 10_000i32
enum paperpaw_graphics::GraphicsError { OutOfMemory { bytes: usize }, UnsupportedFormat(0: paperpaw_platform::pixel::PixelFormat) }
enum paperpaw_graphics::canvas::Role { Heading, Row, Button, Switch, Slider, Text, Check, Radio, Field, Image, Link, Dialog, Progress }
struct paperpaw_graphics::canvas::Canvas<'a> { framebuffer: &'a mut paperpaw_graphics::framebuffer::Framebuffer, clip: paperpaw_platform::geometry::Rect, origin: (i32, i32), described: core::option::Option<&'a mut alloc::vec::Vec<paperpaw_graphics::canvas::Described>> }
