struct paperpaw_graphics::diffuse::Atkinson { rows: [alloc::vec::Vec<i16>; 2] }
struct paperpaw_graphics::framebuffer::Framebuffer { width: u16, height: u16, format: paperpaw_platform::pixel::PixelFormat, stride: usize, top: u16, rows: u16, data: alloc::vec::Vec<u8>, dirty: core::option::Option<paperpaw_platform::geometry::Rect>, inverted: bool, pictures_kept: bool, mono_coverage: u8, saturation: u16, pictured: u32, counting: bool, all_pictured: u32, blind: bool, diffusions: alloc::vec::Vec<(u64, u16, paperpaw_graphics::diffuse::Atkinson)> }
