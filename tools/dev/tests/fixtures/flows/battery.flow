# The battery page from the tools, by touch, on the Boox.
profiles: boox-go-7

# The tips shown at first.
expect screen home.tips
tap-on:OK
expect screen home.dashboard
# A tap in the middle opens the menu.
tap:632:840
expect screen menu.list
tap-on:Tools
expect text "Reading statistics"
tap-on:Battery
expect screen battery.screen
expect text "This time awake"
expect no text "Tools"
expect picture battery
back
expect screen home.dashboard
expect no warnings
